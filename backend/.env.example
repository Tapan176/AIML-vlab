# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
DB_NAME=aiml-lab

# JWT Configuration
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRY_HOURS=24

# File Storage Paths
UPLOAD_DIR=static/uploads
TRAINED_MODELS_DIR=trainedModels
IMAGES_DIR=static/images
PREDICTIONS_DIR=predictions

# Server Configuration
FLASK_PORT=5050
FLASK_DEBUG=true

# CORS — comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Drive — Local development paths (optional)
# GOOGLE_CREDENTIALS_PATH=/path/to/credentials.json
# GOOGLE_TOKEN_PATH=/path/to/token.json

# Allowed File Extensions
ALLOWED_CSV_EXTENSIONS=csv
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png
ALLOWED_ARCHIVE_EXTENSIONS=zip
MAX_UPLOAD_SIZE_MB=50

# --- VERCEL DEPLOYMENT ---
# For Vercel Serverless, provide the raw JSON string of credentials.json and token.json
GOOGLE_CREDENTIALS_JSON='{"web":{"client_id":"...","project_id":"..."}}'
GOOGLE_TOKEN_JSON='{"token":"...","refresh_token":"..."}'

# --- HuggingFace (optional — needed for gated models) ---
HF_TOKEN=hf_your_token_here
# Shared on-disk cache for base models (default: backend/.hf_cache)
# HF_CACHE_DIR=/path/to/shared/hf_cache

# --- OAuth Providers (optional) ---
# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# GitHub OAuth — create at https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Required when OAuth is enabled in a split (frontend/backend on different domains) deploy.
# OAUTH_REDIRECT_BASE — this backend's public URL (no trailing /api); the OAuth
# callback redirect_uri is built from it and must match what's registered with the provider.
# In local dev you may omit it (falls back to the request host).
# OAUTH_REDIRECT_BASE=https://your-backend.example.run.app
# FRONTEND_URL — the SPA's public URL the login popup posts the token back to.
# FRONTEND_URL=https://your-frontend.example.web.app

# --- Subscription / Quotas (optional) ---
# Master switch. Leave false (default) and the app behaves exactly as before:
# no usage limits, subscription UI hidden. Set true to enforce tiered quotas
# and show the plan/usage UI. The frontend reads this at runtime via GET /api/config.
SUBSCRIPTION_ENABLED=false
# Free-tier monthly run caps (only enforced when SUBSCRIPTION_ENABLED=true).
# classical = scikit-learn/XGBoost, deep = CNN/ANN/ResNet/LSTM/YOLO/StyleGAN,
# finetune = BERT/DistilBERT/ViT. 0 blocks that class on the free tier.
# datastudio = Data Studio preprocessing runs.
FREE_TIER_CLASSICAL_RUNS=50
FREE_TIER_DEEP_RUNS=5
FREE_TIER_FINETUNE_RUNS=0
FREE_TIER_DATASTUDIO_OPS=100
# Per-account dataset storage caps (0 = unlimited).
FREE_TIER_MAX_DATASETS=20
PRO_TIER_MAX_DATASETS=200
TEAM_TIER_MAX_DATASETS=1000

# --- Payments: provider ---
# 'lemonsqueezy' (default — works from India, no invite, merchant of record) or
# 'stripe'. Fill in the matching provider's keys below.
PAYMENT_PROVIDER=lemonsqueezy

# --- Lemon Squeezy (recommended for India/global) ---
# API key: https://app.lemonsqueezy.com/settings/api  | Store id + Variant ids
# from your store's Products. Webhook secret: Settings → Webhooks.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_TEAM=
LEMONSQUEEZY_REDIRECT_URL=http://localhost:3000/profile?status=success

# --- Stripe (alternative; invite-only in India) ---
# Get keys from https://dashboard.stripe.com/apikeys (use test keys first).
# Leave blank to disable. Set PAYMENT_PROVIDER=stripe to use these.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from `stripe listen` (local) or the dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs (create Products+Prices in the Stripe dashboard).
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Where Checkout returns the user (frontend URLs).
STRIPE_SUCCESS_URL=http://localhost:3000/profile
STRIPE_CANCEL_URL=http://localhost:3000/pricing
